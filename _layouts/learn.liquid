---
layout: default
---

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article class="learn-content">
    {{ content }}

    {% if page.related_publications %}
      <div class="learn-references">
        <h2>References</h2>
        <div class="publications">
          {% bibliography --group_by none --cited_in_order %}
        </div>
      </div>
    {% endif %}
  </article>
</div>

<script>
window.addEventListener("load", () => {
  const progressBar = document.getElementById("progress");
  const references = document.querySelector(".learn-references");

  if (!progressBar || !references) return;

  function updateLearnProgress() {
    const scrollY =
      window.pageYOffset || document.documentElement.scrollTop || 0;

    const referencesTop =
      references.getBoundingClientRect().top + scrollY;

    const distanceToReferences = Math.max(
      referencesTop - window.innerHeight,
      0
    );

    progressBar.max = distanceToReferences;
    progressBar.value = Math.min(scrollY, distanceToReferences);
  }

  updateLearnProgress();

  document.addEventListener("scroll", updateLearnProgress);
  window.addEventListener("resize", updateLearnProgress);
});
</script>