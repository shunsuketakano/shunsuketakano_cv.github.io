---
layout: default
---

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <!-- ここに class="learn-content" を追加します -->
  <article class="learn-content">
    {{ content }}

    {% if page.related_publications %}
      <h2>References</h2>
      <div class="publications">
        {% bibliography --group_by none --cited_in_order %}
      </div>
    {% endif %}
    {% if page.related_publications %}
      <div class="learn-references">
        <h2>References</h2>
        <div class="publications">
          {% bibliography --group_by none --cited_in_order %}
        </div>
      </div>
    {% endif %}
  </article>
</div>

<script>
window.addEventListener("load", () => {
  const progressBar = document.getElementById("progress");

  if (!progressBar) {
    console.log("[learn progress] progress bar not found");
    return;
  }

  console.log("[learn progress] initial max:", progressBar.max);
  console.log("[learn progress] initial value:", progressBar.value);

  let lastValue = progressBar.value;
  let lastMax = progressBar.max;

  setInterval(() => {
    if (progressBar.value !== lastValue) {
      console.log(
        "[learn progress] value:",
        lastValue,
        "→",
        progressBar.value,
        "scrollY:",
        window.scrollY
      );
      lastValue = progressBar.value;
    }

    if (progressBar.max !== lastMax) {
      console.log(
        "[learn progress] max:",
        lastMax,
        "→",
        progressBar.max
      );
      lastMax = progressBar.max;
    }
  }, 100);
});
</script>