---
layout: default
---

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <!-- ここに class="learn-content" を追加します -->
  <article class="learn-content">
    {{ content }}

    {% if page.related_publications %}
      <h2>References</h2>
      <div class="publications">
        {% bibliography --group_by none --cited_in_order %}
      </div>
    {% endif %}
    {% if page.related_publications %}
      <div class="learn-references">
        <h2>References</h2>
        <div class="publications">
          {% bibliography --group_by none --cited_in_order %}
        </div>
      </div>
    {% endif %}
  </article>
</div>

<script>
window.addEventListener("load", () => {
  const progressBar = document.getElementById("progress");

  console.log("[learn progress] progress bar:", progressBar);
  console.log("[learn progress] references:", document.querySelector(".learn-references"));
  console.log("[learn progress] current value:", progressBar?.value);
  console.log("[learn progress] max:", progressBar?.max);
});
</script>