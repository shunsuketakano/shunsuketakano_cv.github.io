{% if site.outreach %}
  <div class="courses">
    {% assign events_by_year = site.outreach | sort: 'year' | reverse | group_by: 'year' %}
    {% for year_group in events_by_year %}
      <h2 class="year">{{ year_group.name }}</h2>
      <div class="course-list">
        {% assign year_events = year_group.items | sort: 'start_date' | reverse %}
        {% for event in year_events %}
          <div class="course-item">
            <h3 class="course-title">
              <a href="{{ event.url | relative_url }}">{{ event.title }}</a>
            </h3>

            <div class="course-meta">
              {% if event.start_date %}
                <span class="course-term">
                  {{ event.start_date | date: "%d %b %Y" }}
                  {% if event.end_date and event.end_date != event.start_date %}
                    – {{ event.end_date | date: "%d %b %Y" }}
                  {% endif %}
                </span>
              {% endif %}

              {% if event.time %}
                <span class="course-term">{{ event.time }}</span>
              {% endif %}

              {% if event.location %}
                <span class="course-instructor">{{ event.location }}</span>
              {% endif %}
            </div>

            {% if event.topic %}
              <div class="course-description">
                {% for topic in event.topic %}
                  <span>{{ topic }}</span>{% unless forloop.last %} · {% endunless %}
                {% endfor %}
              </div>
            {% endif %}

            {% if event.description %}
              <div class="course-description">
                {{ event.description | markdownify }}
              </div>
            {% endif %}
            {% if event.role %}
              <div class="course-description">
                Role: {{ event.role }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
{% else %}
  <p>No outreach events available yet.</p>
{% endif %}
